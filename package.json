{
  "name": "itantra-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iTantra \u2014 Indian Multilingual Neural Transceiver: interactive web demonstration prototype",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "node --test \"shared/test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "dev:lan": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client:lan\"",
    "dev:client:lan": "npm run dev:lan --workspace client",
    "voices:install": "tsx server/scripts/install-voices.ts",
    "stt:install": "tsx server/scripts/install-stt.ts",
    "models:install": "npm run stt:install && npm run voices:install -- en hi mr",
    "models:stage": "tsx server/scripts/stage-models.ts",
    "image:build": "npm run models:stage && docker build -t ghcr.io/stackht/itantra:latest .",
    "image:push": "docker push ghcr.io/stackht/itantra:latest",
    "build:pages": "npm run build --workspace client",
    "share": "tsx server/scripts/share.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
