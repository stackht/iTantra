# WebSocket hub URL. Leave empty to use the same origin at /ws (Vite proxies it in dev; the hub serves it in production).
VITE_WS_URL=

# true  = never connect to the hub; run the identical simulation engine inside the browser tab.
# false = connect to the hub, and fall back to the in-tab engine automatically if it is unreachable.
VITE_DEMO_MODE=false

# Translation chain on the sending device (browser):
#   mymemory (default) = curated dataset -> Chrome on-device neural pack (if installed) -> MyMemory remote MT
#   mock               = curated dataset only (fully offline, demo phrases only)
VITE_TRANSLATION_PROVIDER=mymemory

# Same switch for the hub's own engine (used when a message arrives without device-side translation).
TRANSLATION_PROVIDER=mymemory

# Hub port (npm run dev:server / npm start).
PORT=8787
